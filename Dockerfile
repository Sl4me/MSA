# Базовый образ с Java 21 (JRE — только для запуска, без компилятора)
FROM eclipse-temurin:21-jre-alpine

# Создаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем наш собранный JAR-файл в контейнер
# ВАЖНО: убедись, что название файла совпадает с тем, что в папке target
COPY target/forum-0.0.1-SNAPSHOT.jar app.jar

# Открываем порт 8080 (информативно)
EXPOSE 8080

# Команда, которая выполнится при запуске контейнера
ENTRYPOINT ["java", "-jar", "app.jar"]